{
  "name": "@suis-ui/core",
  "version": "0.1.0",
  "description": "SUIS, UI library for Solid",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "pnpm build:primitives && pnpm build:kit",
    "build:primitives": "pnpm --filter primitives build",
    "build:kit": "pnpm --filter kit build",

    "example:primitives": "pnpm --filter primitives-example dev",
    "example:kit": "pnpm --filter kit-example dev",

    "docs:dev": "pnpm --filter @suis-ui/docs dev",
    "docs:build": "pnpm --filter @suis-ui/docs build",
    "docs:preview": "pnpm --filter @suis-ui/docs preview",

    "changeset": "changeset",
    "version-changeset": "changeset version && pnpm install",
    "release": "changeset publish"
  },
  "keywords": [],
  "author": "Su-Yong",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@microsoft/api-extractor": "7.58.11",
    "@vanilla-extract/integration": "8.0.10",
    "@vanilla-extract/rollup-plugin": "1.5.4",
    "solid-js": "1.9.14",
    "tsdown": "0.22.9",
    "typescript": "7.0.2",
    "unplugin-solid": "2.0.0",
    "vite": "8.1.5",
    "vite-plugin-solid": "2.11.12"
  }
}
